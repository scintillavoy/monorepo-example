load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "clock",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = [
            "src/bin/**",
        ],
    ),
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True),
)

rust_test(
    name = "clock_test",
    crate = ":clock",
    deps = all_crate_deps(normal_dev = True),
)
